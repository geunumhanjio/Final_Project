                <mxCell id="djloTv2OwbFXEbQ8ZcZW-13" value="&lt;b&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;스트리밍을 위한 여러가지 기술&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
