<RCC>
    <qresource prefix="/">
        <file>style/theme_dark.qss</file>
        <file>style/theme_light.qss</file>
    </qresource>
    <qresource prefix="/crt">
        <file>env/server.crt</file>
    </qresource>
    <qresource prefix="/icons">
        <file>style/icons/spin-up-dark.svg</file>
        <file>style/icons/spin-down-dark.svg</file>
        <file>style/icons/spin-up-light.svg</file>
        <file>style/icons/spin-down-light.svg</file>
        <file>assets/icons/noobigo_app.ico</file>
        <file>assets/icons/noobigo_app.png</file>
        <file>assets/icons/noobigo_wordmark.png</file>
        <file>assets/icons/nubigo_robot.svg</file>
    </qresource>
    <qresource prefix="/fonts">
        <file>assets/fonts/Pretendard-Regular.otf</file>
        <file>assets/fonts/Pretendard-Medium.otf</file>
        <file>assets/fonts/Pretendard-Bold.otf</file>
    </qresource>
</RCC>
