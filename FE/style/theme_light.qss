/* Global Light Theme */
QMainWindow, QWidget {
    background-color: #f8fafc; /* Slate 50 */
    color: #0f172a;        /* Slate 900 */
    font-family: 'Segoe UI', sans-serif;
}

/* Scrollbar */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Sidebar List */
/* Sidebar List */
#SidebarList {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #e2e8f0;
    outline: none;
}
#SidebarList::item {
    padding: 0px;
    background-color: transparent;
    border-bottom: 1px solid #f1f5f9;
}
#SidebarList::item:selected {
    background-color: #fff7ed;
    border-left: 3px solid #ff6b00;
}
#SidebarList::item:hover {
    background-color: #f8fafc;
}
QListWidget::item {
    padding: 12px;
    color: #64748b; /* Slate 500 */
    border-bottom: 1px solid #f1f5f9;
}
QListWidget::item:selected {
    background-color: #fff7ed; /* Orange-50 (Light primary bg) */
    color: #0f172a;
    border-left: 3px solid #ff6b00; /* Orange Primary */
}
QListWidget::item:hover {
    background-color: #f8fafc;
}

/* Search Bar */
QLineEdit {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    padding: 6px;
    color: #0f172a;
}
QLineEdit:focus {
    border: 1px solid #ff6b00; /* Orange focus */
    background-color: #ffffff;
}

/* TopBar */
#TopBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}
#TopBarTitle {
    color: #0f172a;
}
#TopBarNavContainer {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
}

/* TopBar Navigation Buttons */
#TopBarNavBtn {
    background-color: transparent;
    color: #64748b;
    border: none;
    font-size: 11px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 4px;
}
#TopBarNavBtn:hover {
    background-color: #ffffff;
    color: #ff6b00;
}
#TopBarNavBtn[active="true"] {
    background-color: #ff6b00; /* Orange Primary */
    color: white;
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0,0,0,0.1);
}

/* VideoCard */
#VideoCardStatusBar {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
#VideoCardChannelLabel {
    color: #0f172a;
}

/* Right Panel Cards */
#SensorCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
}
#SensorHeader {
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
#SensorTitle {
    color: #0f172a;
}
#SensorValue {
    color: #0f172a;
}

/* Sidebar Specifics */
#SidebarContainer {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
}
#SidebarSearchArea {
    border-bottom: 1px solid #e2e8f0;
}
#SidebarSearchBar {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    padding: 8px;
    color: #0f172a;
    font-size: 12px;
}
#SidebarSearchBar:focus {
    border: 1px solid #ff6b00;
}

/* Sidebar Headers */
#SidebarHeaderTitle {
    color: #64748b;
    font-weight: bold;
    font-size: 11px;
    letter-spacing: 0.5px;
}
#SidebarHeaderCount {
    background-color: rgba(255, 107, 0, 0.1); /* Orange alpha */
    color: #ff6b00;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: bold;
}

/* Sidebar Items */
#SidebarItemIcon {
    color: #64748b; /* Normal state */
    font-size: 14px;
}
#SidebarItemText {
    color: #64748b;
    font-size: 12px;
}
#SidebarItemStatus {
    font-weight: bold;
    font-size: 11px;
}
