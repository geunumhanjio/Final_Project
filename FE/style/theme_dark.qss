/* Global Dark Theme */
QMainWindow, QWidget {
    background-color: #101622;
    color: #f1f5f9;
    font-family: 'Pretendard';
}

/* Scrollbar */
QScrollBar:vertical {
    border: none;
    background: #111722;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #324467;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Sidebar List */
/* Sidebar List */
#SidebarList {
    background-color: #1a2332;
    border: none;
    outline: none;
}
#SidebarList::item {
    background-color: transparent;
    padding: 0px; /* Let internal widget handle padding */
    border-bottom: 1px solid #2a3649;
}
#SidebarList::item:selected {
    background-color: #2a3649;
    border-left: 3px solid #135bec;
}
#SidebarList::item:hover {
    background-color: #2a3649;
}
QListWidget::item {
    padding: 12px;
    color: #cbd5e1;
    border-bottom: 1px solid #2a3649;
}
QListWidget::item:selected {
    background-color: #2a3649;
    color: #ffffff;
    border-left: 3px solid #135bec;
}
QListWidget::item:hover {
    background-color: #2a3649;
}

QListWidget::item:hover {
    background-color: #2a3649;
}

/* Category List (Playback Sidebar) */
#CategoryList {
    background-color: transparent;
    border: none;
    outline: none;
}
#CategoryList::item {
    padding: 12px 16px; 
    color: #CBD5E1; 
    font-size: 14px; 
    border-bottom: 1px solid #1E293B;
}
#CategoryList::item:selected {
    background-color: #2563EB; 
    color: white; 
    font-weight: bold; 
    border-left: 4px solid #60A5FA;
}
#CategoryList::item:hover {
    background-color: #1E293B;
}
QLineEdit {
    background-color: #101622;
    border: 1px solid #2a3649;
    border-radius: 4px;
    padding: 6px;
    color: white;
}
QLineEdit:focus {
    border: 1px solid #135bec;
}

/* TopBar */
#TopBar {
    background-color: #1a2332;
    border-bottom: 1px solid #2a3649;
}
#TopBarTitle {
    color: white;
}
#TopBarNavContainer {
    background-color: rgba(16, 22, 34, 0.5);
    border: 1px solid #2a3649;
    border-radius: 6px;
}

/* TopBar Navigation Buttons */
#TopBarNavBtn {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    font-size: 11px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 4px;
}
#TopBarNavBtn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}
#TopBarNavBtn[active="true"] {
    background-color: #135bec;
    color: white;
    font-weight: 600;
}

#TopBarToggleBtn {
    color: #94a3b8;
    font-size: 20px;
    border: none;
    background: transparent;
}
#TopBarToggleBtn:hover {
    color: white;
    background: rgba(255,255,255,0.05);
    border-radius: 4px;
}

#TopBarTitle {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0px;
    color: #e2e8f0;
    background-color: transparent;
}

#TopBarBrandIcon {
    background: transparent;
}

#DateLabel {
    color: #64748b;
    font-family: monospace;
    font-size: 11px;
    font-weight: bold;
    background-color: transparent;
}

#TimeLabel {
    color: #135bec;
    font-family: monospace;
    font-weight: bold;
    font-size: 14px;
    background-color: transparent;
}

#TopBarAlertButton {
    background: transparent;
    color: #94a3b8;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 700;
}

#TopBarAlertButton:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #fbbf24;
}

#TopBarAlertButton[hasUnread="true"] {
    background: rgba(220, 38, 38, 0.16);
    color: #fecaca;
    border-color: rgba(248, 113, 113, 0.45);
}

#TopBarAlertPopup {
    background: #101827;
    border: 1px solid #334155;
    border-radius: 14px;
}

#TopBarAlertPopupTitle {
    background: transparent;
    color: #f8fafc;
    font-size: 13px;
    font-weight: 800;
}

#TopBarAlertPopupEmpty {
    background: transparent;
    color: #94a3b8;
    font-size: 12px;
}

#TopBarAlertPopupList {
    background: transparent;
    color: #e2e8f0;
    border: none;
    outline: none;
}

#TopBarAlertPopupList::item {
    margin: 0 0 8px 0;
    padding: 10px 12px;
    color: #fee2e2;
    background: rgba(153, 27, 27, 0.28);
    border: 1px solid rgba(248, 113, 113, 0.4);
    border-radius: 10px;
}

#TopBarAlertPopupList::item:hover {
    background: rgba(185, 28, 28, 0.34);
}

#FallAlertPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #dc2626, stop:1 #b91c1c);
    border: 1px solid rgba(254, 202, 202, 0.35);
    border-radius: 16px;
}

#FallAlertTitleLabel {
    background: transparent;
    color: #fff7ed;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.6px;
}

#FallAlertDetailsLabel {
    background: transparent;
    color: rgba(255, 247, 237, 0.92);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
}

#FallAlertAcknowledgeButton {
    background: #fff7ed;
    color: #b91c1c;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 800;
}

#FallAlertAcknowledgeButton:hover {
    background: #ffffff;
}

/* VideoCard */
#VideoCardStatusBar {
    background-color: #1a2332;
    border: 1px solid #2a3649;
    border-top: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
#VideoCardChannelLabel {
    color: white;
}

/* Right Panel Cards */
#SensorCard {
    background-color: #182131;
    border: 1px solid #2a3649;
    border-radius: 8px;
}
#SensorHeader {
    background-color: #1f2b3d;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: 1px solid #2a3649;
}
#SensorTitle {
    color: #e2e8f0;
    background: transparent;
}
#SensorValue {
    color: white;
    background: transparent;
}

/* Sidebar Specifics */
#SidebarContainer {
    background-color: #1a2332;
    border-right: 1px solid #2a3649;
}
#SidebarSearchArea {
    border-bottom: 1px solid #2a3649;
}
#SidebarSearchBar {
    background-color: #101622;
    border: 1px solid #2a3649;
    border-radius: 4px;
    padding: 8px;
    color: white;
    font-size: 12px;
}
#SidebarSearchBar:focus {
    border: 1px solid #135bec;
}

#SidebarModePanel {
    background-color: #111827;
    border-top: 1px solid #2a3649;
    border-bottom: 1px solid #2a3649;
}

#SidebarModeTitle {
    color: #f8fafc;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

QRadioButton#SidebarModeOption {
    color: #e2e8f0;
    font-size: 13px;
    font-weight: 600;
    spacing: 10px;
    padding: 6px 2px;
}

QRadioButton#SidebarModeOption::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton#SidebarModeOption::indicator:unchecked {
    border: 2px solid #64748b;
    border-radius: 8px;
    background: transparent;
}

QRadioButton#SidebarModeOption::indicator:checked {
    border: 2px solid #38bdf8;
    border-radius: 8px;
    background: #38bdf8;
}

#SidebarControlButton {
    background-color: #f59e0b;
    color: #0f172a;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 12px;
}

#SidebarControlButton:hover {
    background-color: #fbbf24;
}

#SidebarControlButton:checked {
    background-color: #dc2626;
    color: white;
}

#SidebarControlButton:disabled {
    background-color: #334155;
    color: #94a3b8;
}

#SidebarEmergencyStopButton {
    background-color: #c2410c;
    color: #fff7ed;
    border: 1px solid rgba(251, 146, 60, 0.55);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 12px;
}

#SidebarEmergencyStopButton:hover {
    background-color: #9a3412;
}

#SidebarEmergencyStopButton:pressed {
    background-color: #7c2d12;
}

#SidebarEmergencyStopButton:disabled {
    background-color: #334155;
    color: #94a3b8;
    border-color: transparent;
}

#SettingsSidebarPanel {
    background-color: #111827;
    border-right: 1px solid #2a3649;
}

#SettingsSidebarTitle {
    color: #f8fafc;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}

#SettingsSidebarSubtitle {
    color: #8ea3bf;
    font-size: 11px;
    line-height: 1.4;
    background: transparent;
}

QPushButton#SettingsSidebarButton {
    background-color: #182234;
    color: #dbe7f6;
    border: 1px solid #2b3a52;
    border-radius: 12px;
    text-align: left;
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#SettingsSidebarButton:hover {
    background-color: #1c2a40;
    border-color: #3b82f6;
}

QPushButton#SettingsSidebarButton:checked {
    background-color: #135bec;
    color: #ffffff;
    border-color: #60a5fa;
}

/* Sidebar Headers */
#SidebarHeaderTitle {
    color: #94a3b8;
    font-weight: bold;
    font-size: 11px;
    letter-spacing: 0.5px;
}
#SidebarHeaderCount {
    background-color: rgba(19, 91, 236, 0.2); /* Blue alpha */
    color: #135bec;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: bold;
}

/* Sidebar Items */
#SidebarItemIcon {
    color: #64748b;
    font-size: 14px;
}
#SidebarItemText {
    color: #cbd5e1;
    font-size: 12px;
}
#SidebarItemStatus {
    font-weight: bold;
    font-size: 11px;
}

#PlaybackHeaderTitle {
    color: #94A3B8;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 1px;
    border-bottom: 1px solid #334155;
}

/* Playback View Main Area (Dark) */
#PlaybackTitle {
    font-size: 24px;
    font-weight: bold;
    color: white;
}

#PlaybackList {
    background-color: #0F172A; 
    border-radius: 8px; 
    border: 1px solid #334155; 
    color: white; 
    font-size: 14px;
    outline: none;
}
#PlaybackList::item {
    padding: 8px; 
    border-bottom: 1px solid #1E293B;
    color: white;
}
#PlaybackList::item:selected {
    background-color: #3b82f6;
    color: white;
}
#PlaybackList::item:hover {
    background-color: #334155;
}

/* Settings View (Dark) */
#SettingsPage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #101622, stop:1 #0b1220);
}

#SettingsTitle {
    background: transparent;
    color: #f8fafc;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
}

#SettingsFormContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #182234, stop:1 #101827);
    border: 1px solid #2b3a52;
    border-radius: 18px;
}

#SettingsPage QLabel {
    background: transparent;
}

#SettingsPage QLabel[settingsRole="label"] {
    color: #dbe7f6;
    font-size: 14px;
    font-weight: 600;
}

#SettingsPage QLabel[settingsRole="section"] {
    color: #93c5fd;
    font-size: 15px;
    font-weight: 700;
}

#SettingsPage QLabel[settingsRole="hint"] {
    color: #8ea3bf;
    font-size: 11px;
    padding: 2px 0 4px 0;
}

#SettingsPage QLineEdit[settingsRole="input"],
#SettingsPage QDoubleSpinBox[settingsRole="input"] {
    background-color: #0d1522;
    color: #f8fafc;
    border: 1px solid #324467;
    border-radius: 10px;
    padding: 10px 12px;
    min-height: 20px;
    selection-background-color: #2563eb;
}

#SettingsPage QLineEdit[settingsRole="input"]:focus,
#SettingsPage QDoubleSpinBox[settingsRole="input"]:focus {
    background-color: #111c2d;
    border: 1px solid #60a5fa;
}

#SettingsPage QDoubleSpinBox::up-button,
#SettingsPage QDoubleSpinBox::down-button {
    width: 24px;
    border-left: 1px solid #324467;
    background-color: #132033;
}

#SettingsPage QDoubleSpinBox::up-button:hover,
#SettingsPage QDoubleSpinBox::down-button:hover {
    background-color: #1a2b44;
}

#SettingsPage QDoubleSpinBox::up-arrow {
    image: url(:/icons/style/icons/spin-up-light.svg);
    width: 12px;
    height: 8px;
}

#SettingsPage QDoubleSpinBox::down-arrow {
    image: url(:/icons/style/icons/spin-down-light.svg);
    width: 12px;
    height: 8px;
}

#SettingsPage QCheckBox[settingsRole="check"] {
    background: transparent;
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 600;
    spacing: 10px;
    padding: 3px 0;
}

#SettingsPage QCheckBox[settingsRole="check"]::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1px solid #4b6a9b;
    background: #0c1421;
}

#SettingsPage QCheckBox[settingsRole="check"]::indicator:hover {
    border-color: #60a5fa;
}

#SettingsPage QCheckBox[settingsRole="check"]::indicator:checked {
    background: #2563eb;
    border-color: #60a5fa;
}

#SettingsSaveButton {
    background-color: #135bec;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 11px 18px;
    font-size: 14px;
    font-weight: 700;
}

#SettingsSaveButton:hover {
    background-color: #2d74f4;
}

#SettingsSaveButton:pressed {
    background-color: #0f49bb;
}

/* =========================================
   FullScreen View Styles (Dark)
   ========================================= */

#FS_TopBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(0,0,0,200), stop:1 transparent);
}

#FS_TitleLabel {
    color: #EAB308; 
    font-weight: bold; 
    font-size: 18px; 
    background-color: rgba(15, 23, 42, 0.6); 
    border-radius: 8px; 
    padding: 4px 12px; 
    border: 1px solid rgba(255, 255, 255, 0.1);
}

#FS_LiveBadge {
    color: #EF4444; 
    font-weight: bold; 
    font-size: 11px; 
    border: 1px solid rgba(239, 68, 68, 0.5); 
    background-color: rgba(220, 38, 38, 0.1); 
    padding: 2px 6px; 
    border-radius: 4px;
}

#FS_CloseBtn {
    background-color: rgba(30, 41, 59, 0.5); 
    color: #CBD5E1; 
    border: 1px solid rgba(51, 65, 85, 0.5); 
    border-radius: 8px; 
    font-size: 16px;
}
#FS_CloseBtn:hover {
    background-color: rgba(220, 38, 38, 0.9); 
    color: white; 
    border-color: #EF4444;
}

/* UnderBar (Dark) */
#controlBar {
    background-color: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
}
#controlBar QPushButton {
    background-color: transparent;
    color: #CBD5E1;
    border: none;
    padding: 8px 15px;
    font-size: 13px; font-weight: 500; font-family: 'Pretendard';
}
#controlBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #FFFFFF;
}
#controlBar QPushButton:checked {
    color: #0EA5E9; font-weight: bold;
    background-color: rgba(14, 165, 233, 0.1);
}

#resetBtn {
    background-color: #0EA5E9; 
    color: white; 
    border-radius: 8px; 
    font-weight: bold;
}
#resetBtn:hover {
    background-color: #38BDF8;
}

#FS_PlaybackContainer {
    background: transparent;
}

#FS_SeekSlider::groove:horizontal {
    border: 1px solid #334155; 
    height: 6px; 
    background: #1E293B; 
    margin: 2px 0; 
    border-radius: 3px;
}
#FS_SeekSlider::handle:horizontal {
    background: #0EA5E9; 
    border: 1px solid #0EA5E9; 
    width: 14px; 
    height: 14px; 
    margin: -5px 0; 
    border-radius: 7px;
}
#FS_SeekSlider::handle:horizontal:hover {
    background: #38BDF8;
}

#timeLabel {
    color: #E2E8F0; 
    font-family: monospace; 
    font-weight: bold;
}
