<?xml version="1.0"?>
<robot name="patrol_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       실측 후 여기만 수정하면 전체 반영됨
       단위: 모두 미터(m)
       ============================================================ -->
  <xacro:property name="base_length"       value="0.220"/>  <!-- 앞뒤 220mm -->
  <xacro:property name="base_width"        value="0.140"/>  <!-- 좌우 140mm -->
  <xacro:property name="base_height"       value="0.200"/>  <!-- 플레이트 두께 60mm (추정) -->

  <xacro:property name="wheel_radius"      value="0.0329"/> <!-- 바퀴 반지름 32.9mm (serial_bridge 캘리브레이션 값과 통일) -->
  <xacro:property name="wheel_width"       value="0.025"/>  <!-- 바퀴 폭 25mm (추정) -->
  <xacro:property name="wheel_separation"  value="0.100"/>  <!-- 좌우 바퀴 중심 간격 100mm (실측) -->

  <!-- base_link 원점 = 로봇 중심, 지면에서 wheel_radius 높이 -->
  <xacro:property name="base_z_offset"     value="${wheel_radius}"/>

  <!-- LiDAR: 로봇 상단 중앙 -->
  <xacro:property name="lidar_x"           value="0.0"/>
  <xacro:property name="lidar_y"           value="0.0"/>
  <xacro:property name="lidar_z"           value="${base_height + 0.020}"/>  <!-- 플레이트 위 20mm -->
  <xacro:property name="lidar_radius"      value="0.035"/>  <!-- YDLiDAR X4 외경 ~70mm -->
  <xacro:property name="lidar_height_val"  value="0.035"/>

  <!-- 카메라: 로봇 전면 -->
  <xacro:property name="camera_x"         value="${base_length/2 - 0.010}"/>
  <xacro:property name="camera_y"         value="0.0"/>
  <xacro:property name="camera_z"         value="${base_height * 0.5}"/>

  <!-- IMU: STM32 보드 위 (대략 중앙) -->
  <xacro:property name="imu_x"            value="0.0"/>
  <xacro:property name="imu_y"            value="0.0"/>
  <xacro:property name="imu_z"            value="${base_height * 0.5}"/>

  <!-- 재질 정의 -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.5 1.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <!-- ============================================================
       base_footprint: 지면 접촉점 (Nav2, SLAM 기준 프레임)
       ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       base_link: 로봇 몸체 중심
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <!-- 전체 로봇 질량 약 1.5kg 가정 -->
      <mass value="1.5"/>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <inertia
        ixx="${1.5/12*(base_width*base_width + base_height*base_height)}"
        iyy="${1.5/12*(base_length*base_length + base_height*base_height)}"
        izz="${1.5/12*(base_length*base_length + base_width*base_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ============================================================
       바퀴 매크로 정의
       ============================================================ -->
  <xacro:macro name="wheel" params="name x_pos y_pos reflect">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <!-- 바퀴 질량 약 0.1kg -->
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${0.1/12*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${0.1/12*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          izz="${0.1/2*wheel_radius*wheel_radius}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel_link"/>
      <!-- x_pos: 앞뒤(0=중앙), y_pos: 좌우, z: 바닥면(base_link 원점 기준) -->
      <origin xyz="${x_pos} ${y_pos} ${-base_z_offset + wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- 좌/우 바퀴 인스턴스 -->
  <xacro:wheel name="left"  x_pos="0" y_pos=" ${wheel_separation/2}" reflect="1"/>
  <xacro:wheel name="right" x_pos="0" y_pos="-${wheel_separation/2}" reflect="-1"/>

  <!-- ============================================================
       캐스터 (앞/뒤 보조 바퀴) - 마찰 없는 구형으로 단순화
       ============================================================ -->
  <xacro:macro name="caster" params="name x_pos">
    <link name="${name}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius * 0.5}"/>
        </geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius * 0.5}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${2.0/5*0.05*(wheel_radius*0.5)*(wheel_radius*0.5)}"
          iyy="${2.0/5*0.05*(wheel_radius*0.5)*(wheel_radius*0.5)}"
          izz="${2.0/5*0.05*(wheel_radius*0.5)*(wheel_radius*0.5)}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_caster_link"/>
      <origin xyz="${x_pos} 0 ${-base_z_offset + wheel_radius*0.5}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster name="front" x_pos=" ${base_length/2 - 0.020}"/>
  <xacro:caster name="rear"  x_pos="-${base_length/2 - 0.020}"/>

  <!-- ============================================================
       LiDAR (YDLiDAR X4)
       ============================================================ -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 ${lidar_height_val/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height_val}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${lidar_height_val/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height_val}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_frame"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       카메라
       ============================================================ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>

  <!-- 카메라 광학 프레임 (Z=앞, X=오른쪽 ROS 이미지 좌표계) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ============================================================
       IMU (MPU6050 on STM32)
       ============================================================ -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.020 0.005"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

</robot>
