<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wsl_bringup</name>
  <version>0.1.0</version>
  <description>WSL bringup package for CCTV-SLAM patrol robot</description>
  <maintainer email="todo@todo.com">근엄한조</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rtsp_bridge</exec_depend>
  <exec_depend>websocket_bridge</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_localization_config</exec_depend>
  <exec_depend>robot_navigation</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
